# Maintainer: Tili20

pkgname=mimic
pkgver=0.1.0
pkgrel=1
pkgdesc="Default applications manager for file types (GTK4/GIO)"
arch=('x86_64')
url="https://github.com/Tili20/mimic"
license=('MIT')
depends=('gtk4')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('c781ee38c215ea637984560df51cc510c79ba5ab5d6fef560e35e5b2a4cb0784')

build() {
  cd "$srcdir/mimic-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$srcdir/mimic-$pkgver"
  cargo test --release --locked
}

package() {
  cd "$srcdir/mimic-$pkgver"

  install -Dm755 target/release/mimic "$pkgdir/usr/bin/mimic"
  install -Dm644 data/org.mimic.Mimic.desktop \
    "$pkgdir/usr/share/applications/org.mimic.Mimic.desktop"
  install -Dm644 data/org.mimic.Mimic.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.mimic.Mimic.svg"
  install -Dm644 data/org.mimic.Mimic.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.mimic.Mimic.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}