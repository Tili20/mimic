<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.mimic.Mimic</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Mimic</name>
  <summary>Default applications manager</summary>
  <description>
    <p>
      Mimic is a simple utility for managing MIME type to application
      associations on Linux. It lets you browse registered file types and choose
      which application should open them by default.
    </p>
    <p>
      The app focuses on minimalism and keyboard navigation, which makes it
      convenient for users of tiling window managers.
    </p>
  </description>
  <launchable type="desktop-id">org.mimic.Mimic.desktop</launchable>
  <developer id="io.github.tili20">
    <name>Tili20</name>
  </developer>
  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>mime</keyword>
    <keyword>default application</keyword>
    <keyword>file associations</keyword>
  </keywords>
  <url type="homepage">https://github.com/Tili20/mimic</url>
</component>